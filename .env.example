# Lunorsoft — environment example. Never commit real secrets.
# Copy to .env and fill values locally.

# PostgreSQL connection string (required by the API + Drizzle)
DATABASE_URL=

# Public base URL the browser uses to reach the API.
# Leave empty for same-origin relative "/api" calls (recommended),
# or set to e.g. https://api.lunorsoft.app when the API is hosted separately.
NEXT_PUBLIC_API_BASE_URL=
